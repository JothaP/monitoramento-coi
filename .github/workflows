name: SAI - Sincronizar Medicoes de Pressao

on:
  schedule:
    # Dois disparos por hora, em UTC; podem sofrer atraso no GitHub Actions.
    - cron: '7,37 * * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: sai-sync-medicoes-pressao
  cancel-in-progress: false

jobs:
  sincronizar:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Obter codigo
        uses: actions/checkout@v4
      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
          cache-dependency-path: 'requirements-sync-pressao.txt'
      - name: Instalar dependencias da sincronizacao
        run: pip install -r requirements-sync-pressao.txt
      - name: Sincronizar OneDrive com SAI
        env:
          MS_TENANT_ID: ${{ secrets.SAI_MS_TENANT_ID }}
          MS_CLIENT_ID: ${{ secrets.SAI_MS_CLIENT_ID }}
          MS_CLIENT_SECRET: ${{ secrets.SAI_MS_CLIENT_SECRET }}
          MS_DRIVE_ID: ${{ secrets.SAI_MS_DRIVE_ID }}
          MS_FOLDER_PATH: SAI/Medicoes_Pressao/Entrada
          GCP_SERVICE_ACCOUNT_JSON: ${{ secrets.SAI_GCP_SERVICE_ACCOUNT_JSON }}
          SAI_SHEET_ID: ${{ secrets.SAI_PRESSAO_SHEET_ID }}
        run: python sai_sincronizar_pressao.py
